# ── Data ──────────────────────────────────────────────────────────────────────
# Commit preprocessed fish oil data so the cluster can train without
# re-processing raw CSVs. Exclude everything else.

# Raw CSVs (~500 MB) — regenerated by scripts/preprocess_fish_oil.py
data/fish_oil/raw/

# Rebuilt on the cluster via scripts/01_download and 02_preprocess
data/pretraining/

# No longer used in this study
data/hemp_seed/
data/olive_oil/

# MTBLS71 urine — not a primary dataset; exclude raw CDFs and all processed outputs
data/mtbls71/

# MTBLS288 rice cultivar — raw CDF files (~5 GB) and generated URL list
data/mtbls288/raw/
data/mtbls288/urls.txt

# Temporary test downloads
data/mtbls71_test/
data/mtbls288_test/

# ── Checkpoints ───────────────────────────────────────────────────────────────
# Large .pt files — transfer to cluster separately
checkpoints/

# ── Results ───────────────────────────────────────────────────────────────────
# Fish oil results are the paper's source of truth and are committed.
results/*
!results/fish_oil/
# the pretraining time and loss the paper quotes
!results/pretrain_summary.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Environments ──────────────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.pdf

# Architecture Diagram Tool
PlotNeuralNet/

# ── Tests / lint ──────────────────────────────────────────────────────────────
.coverage
coverage.xml
htmlcov/
